# AskTrabaajo backend environment variables — variable names only.
# Copy to .env for local development. NEVER commit .env / env.production.

# Environment: development | test | staging | production
ENVIRONMENT=development

# Canonical database (PostgreSQL on Supabase in prod; sqlite allowed in
# development/test only — config fails fast in staging/production).
DATABASE_URL=

# JWT signing secret. REQUIRED (fail-fast) in staging/production.
SECRET_KEY=

# Access/refresh token lifetimes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Legacy MVP backend (migration source; Phase 3 does not use these) -------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_FIRST_NAME=
TEST_USER_LAST_NAME=
TEST_USER_ROLE=
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDT=
CRYPTO_WALLET_SOL=
CRYPTO_WALLET_XRP=
CRYPTO_WALLET_BNB=

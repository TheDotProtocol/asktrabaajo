# Production Environment Configuration
# Database
DATABASE_URL=postgresql://asktrabaajo_prod:secure_password_2024@localhost:5432/asktrabaajo_prod

# Security
SECRET_KEY=your-super-secret-production-key-change-this-immediately
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@asktrabaajo.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@asktrabaajo.com

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Crypto Configuration
CRYPTO_API_KEY=your-crypto-api-key

# CORS Configuration
ALLOWED_ORIGINS=https://asktrabaajo.com,https://www.asktrabaajo.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/asktrabaajo/backend.log

# Performance
WORKERS=4
MAX_CONNECTIONS=100
TIMEOUT=30 
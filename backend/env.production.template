# Production Environment Configuration
# Copy this file to .env.production and fill in your values

# Database
DATABASE_URL=postgresql://asktrabaajo_prod:secure_password_2024@postgres:5432/asktrabaajo_prod

# Security
SECRET_KEY=asktrabaajo-super-secret-production-key-2024-change-this-immediately
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@asktrabaajo.com
SMTP_PASSWORD=your-smtp-password-here
FROM_EMAIL=noreply@asktrabaajo.com

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# CORS Configuration

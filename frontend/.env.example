# AskTrabaajo frontend environment variables — variable names only.
# Copy to .env.local and fill with real values. Never commit .env.local.

# Canonical backend API base URL (same-origin "/api" by default when unset).
NEXT_PUBLIC_API_URL=

# Supabase project credentials (retired in later phases as the API client
# replaces direct database reads; kept while careers reads Supabase directly).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Env-provided demo test user (non-production builds only).
NEXT_PUBLIC_TEST_USER_EMAIL=
NEXT_PUBLIC_TEST_USER_PASSWORD=

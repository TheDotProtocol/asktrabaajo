# Canonical FastAPI origin (no trailing slash). Public — not a secret.
# Local canonical backend: http://localhost:8000
# If unset, the client defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy Careers only — not used by canonical AskTrabaajo authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy Careers demo user (non-production builds only).
NEXT_PUBLIC_TEST_USER_EMAIL=
NEXT_PUBLIC_TEST_USER_PASSWORD=

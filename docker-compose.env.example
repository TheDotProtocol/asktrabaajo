# AskTrabaajo docker-compose environment — variable names only.
# Copy to `.env` next to docker-compose.yml and fill in REAL values.
# NEVER commit `.env` with real secrets (gitignored).

# --- Runtime environment (development | test | staging | production) ---
ENVIRONMENT=production

# --- PostgreSQL (only when using the bundled `postgres` service) ---
POSTGRES_DB=asktrabaajo
POSTGRES_USER=asktrabaajo
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# --- Backend (canonical app) ---
# Canonical database URL. Hosted PostgreSQL (e.g. Supabase) recommended for
# staging/production — the bundled `postgres` service is for local testing.
# sqlite is rejected by the app in staging/production (fail-fast).
DATABASE_URL=postgresql+psycopg2://asktrabaajo:replace-me@postgres:5432/asktrabaajo

# Strong random JWT signing secret (openssl rand -hex 32). REQUIRED.
SECRET_KEY=replace-me-with-a-long-random-value

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://asktrabaajo.com

# Optional for canonical app (AI features are not wired in the canonical
# backend yet — leave empty).
OPENAI_API_KEY=